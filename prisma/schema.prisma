generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guest {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  uniqueLink    String   @unique
  hasResponded  Boolean  @default(false)
  willAttend    Boolean?
  guestsCount   Int?
  message       String?
  respondedAt   DateTime?
  createdAt     DateTime @default(now())
}